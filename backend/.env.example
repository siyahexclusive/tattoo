# Backend environment variables (backend/.env for local dev — never commit this file)
# These are set automatically on Render via the dashboard or render.yaml

# Admin credentials (used to create/sync the admin user on startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password

# Flask secret key (auto-generated on Render)
SECRET_KEY=dev-only-insecure-key

# Database — leave empty for local SQLite, or point to a PostgreSQL URL
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS origins (comma-separated list of allowed frontend URLs)
# Example for production: https://your-site.netlify.app
CORS_ORIGINS=*
